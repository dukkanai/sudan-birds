# Server-side ONLY. Do not put R2 credentials or service-role keys in Flutter.
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
