# Server-side ONLY. Do not put R2 credentials or service-role keys in Flutter.
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_OR_ANON_KEY
# Hosted runtimes may instead provide default entries in SUPABASE_PUBLISHABLE_KEYS
# and SUPABASE_SECRET_KEYS. The adapter accepts those built-in JSON maps.
SUPABASE_SERVICE_ROLE_KEY=USE_EXISTING_SERVER_BUILT_IN_ONLY
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_BUCKET=sudan-birds-media-staging
R2_ACCESS_KEY_ID=SET_THROUGH_SECURE_DEPLOYMENT_SECRETS
R2_SECRET_ACCESS_KEY=SET_THROUGH_SECURE_DEPLOYMENT_SECRETS
# KEEP FALSE until actual Edge resource and R2 integration tests pass.
MEDIA_PIPELINE_ENABLED=false
# Optional approved scheduler only. Leave UNSET until explicit credential approval.
# LIFECYCLE_JOB_SECRET=PROVISION_SEPARATELY_DO_NOT_COMMIT
